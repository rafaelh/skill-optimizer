#!/usr/bin/env -S npx tsx
/**
 * <one-line summary — what this script does and when to run it>.
 *
 * <2-4 line expanded summary. Mention inputs (file/stdin), outputs (stdout/
 * JSON), side effects (writes/network), and any environment requirements.>
 *
 * Usage:
 *   {{script_name}}.ts <input> [--json] [--dry-run]
 *
 * Exit codes:
 *   0   success
 *   1   one or more issues found (or operation declined under --dry-run)
 *   2   bad invocation (missing path, unreadable file, etc.)
 *   3   nothing matched — only for tools that can return an empty result set,
 *       so the agent can tell "no results" apart from "it broke"
 */

import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { parseArgs } from "node:util";
// Convention: shared helpers live in skill_lib.ts (frontmatter parsing,
// sanitizeForEcho, emitError). Import from there rather than duplicating logic.
// import { emitError, sanitizeForEcho } from "./skill_lib.js";

export interface Result {
  code: string;
  message: string;
  severity: "fail" | "warn" | "info";
}

/** Core logic. Pure where possible — easier to unit-test. */
export function run(_target: string): Result[] {
  const results: Result[] = [];
  // ... implement here ...
  return results;
}

function emitText(results: Result[]): void {
  for (const r of results) {
    const prefix = { fail: "FAIL", warn: "WARN", info: "INFO" }[r.severity];
    console.log(`${prefix}: [${r.code}] ${r.message}`);
  }
}

function emitJson(target: string, results: Result[]): void {
  const payload = {
    target,
    results,
    summary: {
      total: results.length,
      fail: results.filter((r) => r.severity === "fail").length,
      warn: results.filter((r) => r.severity === "warn").length,
    },
  };
  console.log(JSON.stringify(payload, null, 2));
}

const HELP = `<one-line summary>

Usage:
  {{script_name}}.ts <input> [--json] [--dry-run]

Options:
  --json       Emit machine-readable JSON on stdout
  --dry-run    Show what would change without writing
  --help       Show this help message
`;

export function main(argv: string[]): number {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      json: { type: "boolean", default: false },
      "dry-run": { type: "boolean", default: false },
      help: { type: "boolean", default: false },
    },
  });

  if (values.help) {
    console.log(HELP);
    return 0;
  }

  const targetArg = positionals[0];
  if (!targetArg) {
    console.error(HELP);
    return 2;
  }

  const target = resolve(targetArg);
  if (!existsSync(target)) {
    console.error(`{{script_name}}: path does not exist: ${target}`);
    return 2;
  }

  const results = run(target);
  if (values.json) {
    emitJson(target, results);
  } else {
    emitText(results);
  }

  return results.some((r) => r.severity === "fail") ? 1 : 0;
}

const isMain = process.argv[1] && import.meta.url === `file://${process.argv[1]}`;
if (isMain) {
  process.exit(main(process.argv.slice(2)));
}
